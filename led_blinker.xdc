current_instance -quiet
current_instance {led_blinker_i/axi_smc/inst/m04_nodes/m04_ar_node/inst/inst_mi_handler/gen_normal_area.inst_fifo_node_payld/gen_xpm_memory_fifo.inst_fifo/gen_mem_rep[1].inst_xpm_memory}
set_max_delay -datapath_only -from [filter [all_fanout -from [get_ports -scoped_to_current_instance -no_traverse clka] -flat -endpoints_only] IS_LEAF] -through [get_pins -of_objects [get_cells -hier * -filter {PRIMITIVE_SUBGROUP==LUTRAM || PRIMITIVE_SUBGROUP==dram || PRIMITIVE_SUBGROUP==drom}] -filter DIRECTION==OUT] 10.000
set_max_delay -datapath_only -from [filter [all_fanout -from [get_ports -scoped_to_current_instance -no_traverse clka] -flat -endpoints_only] IS_LEAF] -to [get_cells -hierarchical -filter {NAME =~ *doutb*reg*}] 10.000

