# ==========================================
# Vivado Specific
# ==========================================
# Ignore Vivado temporary files and logs
*.jou
*.log
*.debug
*.str
*.zip
*.tmp
*.rst
*.os
*.js
*.pb
*.dmp
*.rpx
*.rpt
vivado_pid*

# Ignore specific Vivado build/run directories
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.sdk/
.Xil/
.metadata/
*.data/
*.ipdefs/

# Ignore auto-generated simulation and synthesis files
*_stub.v
*_stub.vhdl
*_funcsim.v
*_funcsim.vhdl

# ==========================================
# Vitis Specific
# ==========================================
# Ignore Vitis build artifacts and temporary folders
/vitis_workspace/
/vitis_proj/*/Debug/
/vitis_proj/*/Release/
*.elf
*.o
*.d
*.a
*.bit
*.mmi
*.xsa

# Ignore IDE-specific project files that contain absolute paths
# Note: In "Unified Vitis" IDE, it's often better to version only 
# specific source files and reconstruct the project via script.
.cproject
.project
.sdkproject
.settings/
RemoteSystemsTempFiles/
webtalk/

# ==========================================
# General / OS
# ==========================================
*~
\#*
.\#*
.DS_Store
Thumbs.db